          "rawQuery": true,
          "rawSql": "SELECT\n  purpose,\n  outcome,\n  count(*) AS attempts\nFROM telemetry.v_identification_attempt\nWHERE run_id = '${run}'::uuid\nGROUP BY 1, 2\nORDER BY 1, 3 DESC",
          "refId": "A"
