          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  coalesce(extraction_outcome, '(not stamped)') AS extraction_outcome,\n  count(*) AS keys\nFROM telemetry.v_resolution_key\nWHERE run_id = '${run}'::uuid\nGROUP BY 1\nORDER BY 2 DESC",
          "refId": "A"
        }
