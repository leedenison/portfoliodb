FROM golang:1.25-alpine AS builder
WORKDIR /app
RUN go install github.com/bufbuild/buf/cmd/buf@latest \
    && go install google.golang.org/protobuf/cmd/protoc-gen-go@latest \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest \
    && go install github.com/grpc-ecosystem/grpc-health-probe@latest
COPY go.mod go.sum ./
RUN go mod download
COPY proto/ proto/
COPY buf.yaml buf.lock buf.gen.go.yaml ./
RUN buf generate --template buf.gen.go.yaml
COPY server/ server/
ARG BUILD_REV=unknown
RUN go build -tags e2e -ldflags "-X main.buildRevision=$BUILD_REV" -o /portfoliodb ./server/cmd/portfoliodb

FROM alpine:3.19
RUN apk --no-cache add ca-certificates
COPY --from=builder /portfoliodb /portfoliodb
# scripts/server-ready.sh probes gRPC health from inside this container.
COPY --from=builder /go/bin/grpc-health-probe /usr/local/bin/grpc-health-probe
COPY server/migrations /migrations
EXPOSE 50051
ENTRYPOINT ["/portfoliodb"]
CMD ["-grpc-addr", ":50051", "-db-url", "postgres://portfoliodb:portfoliodb@postgres:5432/portfoliodb?sslmode=disable"]
