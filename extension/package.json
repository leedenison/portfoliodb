{
  "name": "portfoliodb-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension that automates broker transaction import into PortfolioDB",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "big.js": "7.0.1",
    "papaparse": "5.5.3"
  },
  "devDependencies": {
    "@types/big.js": "7.0.0",
    "@types/chrome": "^0.0.287",
    "@types/papaparse": "5.5.2",
    "eslint": "^9.39.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
